# ============================================================
# 福建海峡银行网点查询后端 —— 环境变量配置模板
# 复制本文件为 .env 并填入真实值（.env 不入库、不提交）
# ============================================================

# 服务监听端口
PORT=3000

# 数据提供方：mock（无密钥示例）/ qcc（企查查）/ tyc（天眼查）
# 正式上线请改为 qcc 或 tyc，并填写下方对应密钥
DATA_PROVIDER=mock

# —— 企查查 Open API（DATA_PROVIDER=qcc 时必填）——
# 在企查查开放平台(https://openapi.qcc.com) 申请 AppKey / AppSecret
QCC_APP_KEY=
QCC_APP_SECRET=
# 可选：自定义接口域名（默认 https://api.qcc.com）
# QCC_BASE_URL=https://api.qcc.com

# —— 天眼查 Open API（DATA_PROVIDER=tyc 时必填）——
# 在天眼查开放平台申请的接口 token
TYC_TOKEN=
# 可选：自定义接口域名（默认 https://open.api.tianyancha.com/services/open/2.0）
# TYC_BASE_URL=https://open.api.tianyancha.com/services/open/2.0

# —— 可选：腾讯地图 WebService 密钥 ——
# 配置后，会对机构“注册地址”做精确地理编码，最近网点判断更准；
# 不配置则自动回退到“行政区划中心坐标”（区县级近似）。
MAP_KEY=
