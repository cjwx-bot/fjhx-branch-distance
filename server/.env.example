# ============================================================
# 福建海峡银行网点查询后端 —— 环境变量配置模板
# 复制本文件为同目录 .env 并填入真实值（.env 不入库、不提交）
#
# 地图数据源合规：仅允许腾讯地图 / 高德 / 百度 / 天地图。
# 本服务默认使用高德地图开放平台 Web服务 API（GCJ-02），Key 仅服务端持有。
# ============================================================

# 服务监听端口（托管环境由 PORT 注入，本地默认 3000）
PORT=3000

# —— 地图数据源选择：amap（默认，高德） / tencent（腾讯，可回滚）——
# 两条通道均为合规白名单、同为 GCJ-02，与 91 家网点基准坐标一致，无需坐标转换。
GEO_PROVIDER=amap

# —— 高德地图开放平台「Web服务」类型 Key ——
# 申请入口：https://console.amap.com/ → 应用管理 → 创建新应用 → 添加 Key → 服务平台选「Web服务」
# ⚠️ 必须选择「Web服务」平台，Web端(JS API)/Android/iOS 类型的 Key 会返回 USERKEY_PLAT_NOMATCH。
# 建议单独申请一把仅用于本工具、配额受限、可随时轮换的 Key，不要复用其他业务 Key。
# 个人开发者 Key 存在 QPS 限流，服务端已内置串行节流、退避重试与 24h 缓存。
# 请自行申请后替换下面整行占位符；未配置时 /api/geo 会如实返回 no-key 并回退离线定位。
# ⚠️ .env 会随部署包进入托管沙箱（后端调用需要），请勿提交到公开仓库。
# ⚠️ Key 不会出现在 HTML / JS / 接口响应 / 日志中，前端页面始终零 Key。
MAP_KEY=Please apply for your own key at the 高德地图开放平台 and replace this placeholder

# 定位范围与超时（可选）
GEO_REGION=福建
GEO_TIMEOUT_MS=4500

# —— 单位画像（编制参阅材料时经 /api/profile 调取）——
# local（默认）：调取 WorkBuddy 会话侧由启信慧眼已授权接口核验后落盘的公开级画像库
#                intel/org_profile.json，零凭据、零外部请求，覆盖已补齐机构。
# qixin-mcp    ：直连 https://mcp.qixin.com/mcp 实时查任意机构，需官方「显示密钥」给出的
#                mcp- 格式密钥（Authorization: Bearer）。⚠️ ent_ 形态不是该端点的 Bearer 令牌，
#                实测返回 401「OAuth access token 无效」，切勿填入。
PROFILE_PROVIDER=local
QIXIN_MCP_KEY=
PROFILE_TIMEOUT_MS=6000

# /api/org 主体信息扩展点（mock / qcc / tyc），与实时定位、单位画像均无关
DATA_PROVIDER=mock

# —— 企查查 Open API（DATA_PROVIDER=qcc 时必填）——
QCC_APP_KEY=
QCC_APP_SECRET=
# QCC_BASE_URL=https://api.qcc.com

# —— 天眼查 Open API（DATA_PROVIDER=tyc 时必填）——
TYC_TOKEN=
# TYC_BASE_URL=https://open.api.tianyancha.com/services/open/2.0
